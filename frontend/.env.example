# URL of the FastAPI backend. Leave empty in development (Vite proxies /api to localhost:8000).
# On Vercel set it to your backend project URL, e.g. https://ivp-studio-api.vercel.app
VITE_API_URL=

# Longest image side uploaded to the backend. Empty/0 = full resolution (local use).
# On Vercel with the Render free tier, set 2048 so big photos are shrunk in the browser first.
VITE_MAX_UPLOAD_SIDE=
